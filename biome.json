{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"style": {
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"conventions": [
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"match": "(?:GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)|(.+)",
								"formats": ["camelCase"]
							}
						]
					}
				}
			},
			"correctness": {
				"noUnresolvedImports": "off",
				"noNodejsModules": "off"
			}
		}
	},
	"javascript": {
		"globals": ["Bun"],
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["src/__tests__/**"],
			"linter": {
				"rules": {
					"style": {
						"noMagicNumbers": "off",
						"noProcessEnv": "off"
					}
				}
			}
		}
	]
}
