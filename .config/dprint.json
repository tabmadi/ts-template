// The formatter of JSON, JSONC, TOML, and YAML, per ADR-0104. The dprint wrapper in flake.nix
// passes this path and the plugins, because dprint takes both only as flags.
{
  "json": { "indentWidth": 2, "useTabs": false, "newLineKind": "lf" },
  "toml": { "indentWidth": 2, "useTabs": false, "newLineKind": "lf" },
  "yaml": { "indentWidth": 2, "lineBreak": "lf" },
  "excludes": [".direnv", "result"]
}
